# ==============================================================================
# SENTINEL - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Alpaca Paper Trading Credentials (https://alpaca.markets/)
# IMPORTANT: Never use live trading keys! Keep PAPER_TRADE set to true.
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER_TRADE=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# AI / LLM Configuration
# Configurable AI service provider (Google Gemini or OpenAI-compatible)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback provider
OPENAI_API_KEY=

# Supabase / PostgreSQL Credentials (https://supabase.com/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sentinel Risk Engine Default Rules (Deterministic Thresholds)
RISK_MAX_POSITION_EXPOSURE_PCT=10.0
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_DAILY_TRADES=10
RISK_MIN_AI_CONFIDENCE=70
RISK_MAX_SINGLE_TRADE_ALLOCATION_PCT=5.0
RISK_MAX_PORTFOLIO_CONCENTRATION_PCT=25.0
